{
  "name": "install-script-plugin",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Declares no install script but ships a postinstall script.",
  "main": "./lib/index.js",
  "scripts": {
    "postinstall": "node scripts/setup.js"
  },
  "dsh": {
    "capabilities": {
      "network": { "fetch": false },
      "process": { "child_process": false, "exec": false },
      "filesystem": { "read": false, "write": false },
      "env": { "read": [] },
      "tool_registry": { "add": false, "override": false, "intercept": false },
      "context": {
        "prompt_inject": false,
        "tool_output_rewrite": false,
        "history_compress": false
      },
      "lifecycle": {
        "preinstall": false,
        "install": false,
        "postinstall": false,
        "prepare": false
      },
      "auto_update": false
    }
  }
}
