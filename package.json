{
  "name": "dsh-plugin-trust-broker",
  "version": "0.1.0",
  "private": true,
  "description": "Pre-install capability review, content-hash trust anchors, and runtime audit for DeepSeek Harness plugins.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin-security",
    "supply-chain-security",
    "trust-broker",
    "audit-log"
  ],
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
  },
  "main": "./dist/plugin/index.js",
  "types": "./dist/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli/main.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-trust-broker": "./bin/trust-broker.mjs"
  },
  "files": [
    "dist/**",
    "bin/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/**",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "capabilities": {
      "network": {
        "fetch": false,
        "socket": false
      },
      "process": {
        "child_process": true,
        "exec": false
      },
      "filesystem": {
        "read": true,
        "write": true
      },
      "env": {
        "read": [
          "DSH_TRUST_BROKER_STORE",
          "DSH_HOME",
          "NO_COLOR",
          "HOME",
          "USERPROFILE",
          "TMPDIR",
          "TMP",
          "TEMP",
          "SystemRoot",
          "windir"
        ]
      },
      "tool_registry": {
        "add": false,
        "override": false,
        "intercept": true
      },
      "context": {
        "prompt_inject": false,
        "tool_output_rewrite": false,
        "history_compress": false
      },
      "lifecycle": {
        "preinstall": false,
        "install": false,
        "postinstall": false,
        "prepare": false
      },
      "credentials": {
        "read": false
      },
      "dynamic_code": {
        "eval": false
      },
      "auto_update": false
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2+": "compatible",
        "0.2.1-rc.2+": "compatible",
        "0.2.2-rc.1+": "compatible"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "cli": "node src/cli/entry.ts",
    "demo": "node src/cli/entry.ts review examples/demo-plugin --store-dir .demo-store --no-external-scanner",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.8.3"
  }
}
